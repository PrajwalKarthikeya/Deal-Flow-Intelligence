# Backend — .env.example
# Copy to .env and fill in actual values

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dealflow
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/dealflow

# Application
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security
SECRET_KEY=change-me-in-production
